{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "ignorePatterns": ["dist", "reference", "assets-inbox", "deploy/pb_migrations", "deploy/pb_hooks"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["react", "react-*", "phaser", "pocketbase", "../ui/*", "../game/*", "../sync/*"],
                "message": "src/core — чистая логика: без React, Phaser, сети."
              }
            ]
          }
        ]
      }
    }
  ]
}
