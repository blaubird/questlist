    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
